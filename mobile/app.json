{
  "expo": {
    "name": "Diverty",
    "slug": "diverty-oficial-native",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divertypanama.reservas"
    },
    "android": {
      "package": "com.divertypanama.reservas"
    },
    "plugins": [
      "expo-sharing",
      ["expo-image-picker", {"photosPermission": "Diverty usa las fotos que selecciones para el catálogo y la galería de tu página web.", "cameraPermission": false, "microphonePermission": false}]
    ]
  }
}
